# ─── Admin credentials ───────────────────────────────────────────────
# Generate:  node scripts/hash-password.mjs "your-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Dev-only fallback. Ignored in production, by design.
ADMIN_PASSWORD=

# ─── Token signing ───────────────────────────────────────────────────
# Printed by hash-password.mjs, or:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_TOKEN_SECRET=

# ─── Two-factor (Microsoft Authenticator) ────────────────────────────
# Generate + scan the QR:  node scripts/setup-2fa.mjs
# Leave blank to run with password only (not recommended).
ADMIN_TOTP_SECRET=

# ─── Storage ─────────────────────────────────────────────────────────
# Added automatically when you connect a PUBLIC Blob store in Vercel.
BLOB_READ_WRITE_TOKEN=

# ─── Public site URL (optional, used for QR / share links) ───────────
NEXT_PUBLIC_SITE_URL=
