# ─── Admin credentials ───────────────────────────────────────────────
# Generate a hash locally:  node scripts/hash-password.mjs "my-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Dev-only fallback. NEVER set this in production.
ADMIN_PASSWORD=

# ─── Token signing ───────────────────────────────────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_TOKEN_SECRET=

# ─── Storage ─────────────────────────────────────────────────────────
# Created automatically when you add a Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=

# ─── Public site URL (optional, used for QR/share links) ─────────────
NEXT_PUBLIC_SITE_URL=
